{
  "name": "@vendua/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && bun scripts/budget.ts",
    "build:native": "vite build --mode native && bun scripts/budget.ts --native && bun scripts/bundle-native.ts",
    "cap:sync": "bun run build:native && cap sync"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
