{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(bun x tsc --noEmit -p tsconfig.json)",
      "mcp__github__pull_request_read"
    ],
    "deny": [
      "Read(./packages/conformance/stale/*/dist/**)",
      "Read(./apps/*/dist/**)",
      "Read(./storefronts/**/dist/**)",
      "Read(./packages/conformance/fixtures/*/dist/**)",
      "Read(./**/qa-report/**)",
      "Read(./test-results/**)",
      "Read(./playwright-report/**)",
      "Read(./packages/core/sim-results/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f && [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown --ignore-path \"$CLAUDE_PROJECT_DIR/.prettierignore\" --log-level warn \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
