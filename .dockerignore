# Keep the build context small: the image only needs the root manifests and
# site/. Everything below is regenerated or unrelated.
.git
.gitignore
node_modules
**/node_modules
site/build
site/.svelte-kit
site/test-results
site/playwright-report
site/artifacts
docs
packages
storefronts
tools
site/tests
site/playwright.config.ts
README.md
site/README.md
site/VALIDACAO.md
.env
.env.*
!.env.example
*.log
nul
