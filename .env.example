# Copy to .env (Dokploy: paste into the service's Environment tab).
# Generate secrets: openssl rand -hex 32

# Postgres superuser password (migrations run as this role).
POSTGRES_PASSWORD=

# Password for the `vendua_app` application role — migrate-cli rotates it.
VENDUA_APP_DB_PASSWORD=

# Signs storefront session tokens (vst.*). Unset = random per boot, which
# invalidates every open cart on each restart — always set in production.
SESSION_SECRET=

# Staff login key for /control/ — must differ from SESSION_SECRET (staff
# access never doubles as shopper-signing); unset falls back to SESSION_SECRET.
CONTROL_SECRET=

# Trusted-proxy appends between client IP and Core in X-Forwarded-For — the
# chain is client → Traefik → edge (or the crm/admin nginx) → core, so 1.
VENDUA_PROXY_HOPS=1

# The storefront edge's key for Core's /edge/v1/resolve (same value on both services).
VENDUA_EDGE_SECRET=

# Where storefront releases live: the compose `artifacts` volume (default,
# file:///var/lib/vendua/artifacts) or an S3-compatible bucket (R2, MinIO):
#   VENDUA_ARTIFACTS=s3://vendua-artifacts
# with S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_ENDPOINT (and S3_REGION, default auto).
VENDUA_ARTIFACTS=

# Synthetic probes (every live host, 60 s) verify deployments and open incidents.
# 1 (default) = on. VENDUA_PROBE_ORIGIN unset = probe https://<host> end to end;
# http://edge:8080 = through the edge only, when the VPS can't reach its own public IP.
VENDUA_PROBES=1
VENDUA_PROBE_ORIGIN=

# 1 = on each boot, create the quero-pudim store (tenant, owner, CRM record) if it's
# missing; 0 (default) = never seed. In production the seed only adds: an existing
# store keeps its domains, settings, catalog and owners and only gains new
# SEED_DOMAINS hosts. Turn it on for a first boot, then back to 0.
SEED_DEMO=0

# The seeded store's owner in the merchant admin (phone: national digits, DDD +
# number). Used only when the seed creates the store; unset = a fake dev owner
# (Dono Dev, 22999990001, dono@example.com) — set real values before seeding prod.
SEED_OWNER_NAME=
SEED_OWNER_PHONE=
SEED_OWNER_EMAIL=

# Public domain per seeded tenant (routing is Host-header based).
# Format: slug:domain[,slug:domain]; extra hosts per slug separated by |.
# The first public host per slug becomes the store's primary domain — the one
# address every admin link (share, QR, "ver loja") points at.
SEED_DOMAINS=quero-pudim:pudim.example.com

# Merchant admin: its own domain (attach it to the `admin` service).
VENDUA_ADMIN_HOST=painel.example.com
# Fallback store address: a store with no public domains row lives at
# <slug>.<VENDUA_STORE_DOMAIN>, and Core routes that host to it (needs a wildcard
# DNS record + certificate). Links always prefer the store's primary domain.
VENDUA_STORE_DOMAIN=example.com

# Web push for new orders (npx web-push generate-vapid-keys); unset = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@example.com

# Ajuda's "chamar no WhatsApp" number (digits only); unset = in-app message only.
VENDUA_SUPPORT_WHATSAPP=

# Driver API keys — each driver reads its secret_ref env, or the default
# below when null. Unset = driver reports "ausente" in /control Config.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
TINYFISH_API_KEY=

# whsec_… secret of the Resend `email.received` webhook pointing at
# https://<crm-domain>/control/v1/webhooks/email. Unset = inbound email rejected.
RESEND_WEBHOOK_SECRET=

# Shared secret gating manual/relay posts to /control/v1/webhooks/:channel
# (x-vendua-webhook header). Unset = derived from CONTROL_SECRET.
VENDUA_WEBHOOK_SECRET=

# The team's Discord bot (docs/deploy/discord.md): the bot token from the Discord
# Developer Portal. The application id, public key, server and channels are set in
# the CRM (Config → Discord). Unset = no Discord delivery; events still recorded.
DISCORD_BOT_TOKEN=

# monid.ai gateway for the agent's paid enrichment tools
# (maps_lookup/instagram_profile/serp) — read directly, not a /control driver.
MONID_API_KEY=

# Google Calendar sync for /control meetings — optional. Prefer the B64
# variant (whole SA JSON base64'd — easier to paste on Dokploy).
# Unset = sync disabled (warn-logged once at boot).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# daily.co per-meeting video rooms for /control meetings — optional.
# Unset = meetings keep the static meeting.roomUrl setting.
DAILY_API_KEY=

# pino level for core (default info) / the Baileys socket logger (default
# warn — baileys is chatty). Compose already forwards these with defaults.
LOG_LEVEL=
BAILEYS_LOG_LEVEL=

# Instagram DMs (services/ig-sidecar) — optional. One shared secret: Core →
# sidecar bearer token and sidecar → Core event signature (openssl rand -hex 32).
# Unset = the sidecar idles; enable the instagram "sidecar" driver in /control
# config and log in there. IG_PROXY: static residential http(s)/socks5 proxy —
# Instagram challenges logins from datacenter IPs. IG_MIN_SEND_GAP_SECONDS
# paces DMs account-wide (default 20, plus jitter).
IG_SIDECAR_SECRET=
IG_PROXY=
IG_MIN_SEND_GAP_SECONDS=
IG_SIDECAR_LOG_LEVEL=

# Mercado Pago (docs/deploy/dokploy.md#2-set-environment-variables). Unset = offline payments only.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Venduá's own MP account — plan billing; unset = self-serve signup closed.
MP_PLATFORM_ACCESS_TOKEN=
# Signup access code (openssl rand -hex 16; under 12 characters = ignored). Whoever types it at
# the last signup step creates the store without Mercado Pago: it stays closed behind its first
# plan invoice until the team marks that invoice paid in the CRM (Lojas → the store → marcar como
# pago); renewals then show up there each month the same way. Unset = off.
VENDUA_SIGNUP_ACCESS_CODE=
# Seals stores' MP tokens (openssl rand -hex 32); unset = derived from SESSION_SECRET
# (Core warns at boot). Safe to set later: tokens sealed before still open.
VENDUA_SECRETS_KEY=
# The site's sign-up links: https://<VENDUA_ADMIN_HOST> (build arg of the site image).
PUBLIC_ADMIN_URL=https://painel.vendua.com.br
