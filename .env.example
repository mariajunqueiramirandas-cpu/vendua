# Copy to .env (Dokploy: paste into the service's Environment tab).
# Generate secrets: openssl rand -hex 32

# Postgres superuser password (migrations run as this role).
POSTGRES_PASSWORD=

# Password for the `vendua_app` application role — migrate-cli rotates it.
VENDUA_APP_DB_PASSWORD=

# Signs storefront session tokens (vst.*). Unset = random per boot, which
# invalidates every open cart on each restart — always set in production.
SESSION_SECRET=

# Staff login key for /control/ — must differ from SESSION_SECRET (staff
# access never doubles as shopper-signing); unset falls back to SESSION_SECRET.
CONTROL_SECRET=

# Trusted-proxy appends between client IP and Core in X-Forwarded-For — the
# chain is client → Traefik → storefront nginx → core, so 1.
VENDUA_PROXY_HOPS=1

# 1 = seed the three demo tenants/catalogs on first boot; 0 = empty platform.
SEED_DEMO=1

# Public domain per seeded tenant (routing is Host-header based).
# Format: slug:domain[,slug:domain]; extra hosts per slug separated by |.
SEED_DOMAINS=quero-pudim:pudim.example.com,brasa:brasa.example.com,forn:forn.example.com

# Driver API keys — each driver reads its secret_ref env, or the default
# below when null. Unset = driver reports "ausente" in /control Config.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
TINYFISH_API_KEY=

# whsec_… secret of the Resend `email.received` webhook pointing at
# https://<crm-domain>/control/v1/webhooks/email. Unset = inbound email rejected.
RESEND_WEBHOOK_SECRET=

# Shared secret gating manual/relay posts to /control/v1/webhooks/:channel
# (x-vendua-webhook header). Unset = derived from CONTROL_SECRET.
VENDUA_WEBHOOK_SECRET=

# monid.ai gateway for the agent's paid enrichment tools
# (maps_lookup/instagram_profile/serp) — read directly, not a /control driver.
MONID_API_KEY=

# Google Calendar sync for /control meetings — optional. Prefer the B64
# variant (whole SA JSON base64'd — easier to paste on Dokploy).
# Unset = sync disabled (warn-logged once at boot).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# daily.co per-meeting video rooms for /control meetings — optional.
# Unset = meetings keep the static meeting.roomUrl setting.
DAILY_API_KEY=

# pino level for core (default info) / the Baileys socket logger (default
# warn — baileys is chatty). Compose already forwards these with defaults.
LOG_LEVEL=
BAILEYS_LOG_LEVEL=

# Instagram DMs (services/ig-sidecar) — optional. One shared secret: Core →
# sidecar bearer token and sidecar → Core event signature (openssl rand -hex 32).
# Unset = the sidecar idles; enable the instagram "sidecar" driver in /control
# config and log in there. IG_PROXY: static residential http(s)/socks5 proxy —
# Instagram challenges logins from datacenter IPs. IG_MIN_SEND_GAP_SECONDS
# paces DMs account-wide (default 20, plus jitter).
IG_SIDECAR_SECRET=
IG_PROXY=
IG_MIN_SEND_GAP_SECONDS=
IG_SIDECAR_LOG_LEVEL=
