# Copy to .env (Dokploy: paste into the service's Environment tab).
# Generate secrets: openssl rand -hex 32

# Postgres superuser password (migrations run as this role).
POSTGRES_PASSWORD=

# Password for the `vendua_app` application role — migrate-cli rotates it.
VENDUA_APP_DB_PASSWORD=

# Signs storefront session tokens (vst.*). Unset = random per boot, which
# invalidates every open cart on each restart — always set in production.
SESSION_SECRET=

# Staff login key for the CRM at /control/ — what you type on the login page.
# Distinct from SESSION_SECRET on purpose: staff access must never double as
# a shopper-signing key. Rotating it invalidates every staff session at once.
# Unset = falls back to SESSION_SECRET (dev convenience, wrong for prod).
CONTROL_SECRET=

# Trusted proxy appends between the client IP and Core in X-Forwarded-For.
# The compose chain is client → Traefik → storefront nginx → core, so 1
# (nginx's append is skipped from the right to reach the client IP).
VENDUA_PROXY_HOPS=1

# 1 = seed the three demo tenants/catalogs on first boot; 0 = empty platform.
SEED_DEMO=1

# Public domain per seeded tenant — tenant routing is Host-header based, so
# each storefront's Dokploy domain must be registered here at seed time.
# Format: slug:domain[,slug:domain]; extra hosts per slug separated by |.
SEED_DOMAINS=quero-pudim:pudim.example.com,brasa:brasa.example.com,forn:forn.example.com

# ── agent / CRM integrations ────────────────────────────────────────────────
# Driver API keys — each driver reads its configured secret_ref env var, or
# the default below when the row's secret_ref is null. Unset = driver reports
# "ausente" in /control Config.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
TINYFISH_API_KEY=

# Svix signing secret for inbound email: create an `email.received` webhook
# in Resend pointing at https://<crm-domain>/control/v1/webhooks/email and
# paste its whsec_… secret here. Unset = inbound email events are rejected.
RESEND_WEBHOOK_SECRET=

# Shared secret gating manual/relay posts to /control/v1/webhooks/:channel
# (x-vendua-webhook header). Unset = derived from CONTROL_SECRET.
VENDUA_WEBHOOK_SECRET=
