{
  "name": "@vendua/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:up": "docker compose up -d postgres",
    "migrate": "bun src/platform/migrate-cli.ts",
    "migration:new": "bun ../../tools/new-migration.mjs",
    "sim": "bun src/agent/sim-cli.ts",
    "sims:vendedor": "bun src/vendedor/sims/cli.ts",
    "seed": "bun src/platform/seed.ts",
    "seed:fixtures": "bun src/platform/seed-fixtures.ts",
    "seed:fleet": "bun src/platform/seed-fleet.ts",
    "seed:customers": "bun src/platform/seed-customers.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "import:probe": "bun src/modules/menu-import/probe-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@openrouter/sdk": "1.3.2",
    "@vendua/agent-runtime": "workspace:*",
    "@vendua/loader": "workspace:*",
    "@vendua/templates": "workspace:*",
    "baileys": "7.0.0-rc14",
    "hono": "4.10.7",
    "pino": "9.14.0",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  }
}
